# OpenAudit AI — Environment Configuration
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env

# OpenAI API key (required for AI-powered explanations)
OPENAI_API_KEY=your_api_key_here

# OpenAI API base URL (optional — defaults to https://api.openai.com/v1)
# Change this to use a compatible provider (Azure OpenAI, local LLM proxy, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1

# Model to use for explanations (optional — defaults to gpt-5-mini)
# Available models: gpt-5.2, gpt-5.2-pro, gpt-5.1, gpt-5, gpt-5-mini, gpt-5-nano
# If the configured model is unavailable, falls back to gpt-4o-mini automatically.
OPENAI_MODEL=gpt-5-mini
